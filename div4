function searchAccount(searchText) {

    searchText = $.trim(searchText).toLowerCase();

    if (searchText === "") {
        populateDiv66(all_data);
        return;
    }

    var filteredResponse = $.extend({}, all_data);

    filteredResponse.data = all_data.data.filter(function(item) {

        return (item.accountNumber || "").toLowerCase().includes(searchText) ||
               (item.accountName || "").toLowerCase().includes(searchText);

    });

    filteredResponse.resultCount = filteredResponse.data.length;
    filteredResponse.totalCount = filteredResponse.data.length;

    populateDiv66(filteredResponse);
}