function searchAccount(searchText) {
    searchText = searchText.trim().toLowerCase();

    const rows = document.querySelectorAll(".div66-data tr");

    rows.forEach(function(row) {

        const accountButton = row.querySelector("td:first-child button");
        const cells = row.querySelectorAll("td");

        if (!accountButton || cells.length < 2) {
            return;
        }

        const accountNumber = accountButton.textContent.trim().toLowerCase();
        const accountName = cells[1].textContent.trim().toLowerCase();

        if (searchText === "" ||
            accountNumber.includes(searchText) ||
            accountName.includes(searchText)) {

            row.classList.remove("dontdisplay");

        } else {

            row.classList.add("dontdisplay");
        }
    });
}