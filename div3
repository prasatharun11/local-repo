function searchAccount(searchText) {

    searchText = $.trim(searchText).toLowerCase();

    if (searchText === "") {
        populateDiv66(all_data);
        return;
    }

    var filteredData = all_data.filter(function(item) {

        return (item.accountNumber || "").toLowerCase().includes(searchText) ||
               (item.accountName || "").toLowerCase().includes(searchText);
    });

    populateDiv66(filteredData);
}